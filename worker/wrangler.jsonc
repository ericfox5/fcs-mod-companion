{
  // NCAA Online Dynasty 14 revival — companion site + bridge API (fan project, not affiliated with EA)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncaa-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // fcs-mod.online is a Workers custom domain (zone on this account); listed here so a deploy keeps it attached
  "routes": [{ "pattern": "fcs-mod.online", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ncaa-online", "database_id": "b8320f33-beec-491b-bc76-84d9ceb44a98", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "SAVES", "bucket_name": "ncaa-online-saves" }
  ],
  "vars": {
    "SITE_NAME": "NCAA Online Dynasty FCS",
    "BASE_YEAR": "2013",
    "SUPERSIM_ENABLED": "true",
    // Open sign-up + public league server. "false" keeps /signup closed (invite links keep working); set "true" to open it.
    "OPEN_SIGNUP": "false",
    "LEAGUE_SERVER_HOST": "play.fcs-mod.online",
    "SETUP_DOWNLOAD_URL": "https://github.com/ericfox5/fcs-mod-companion/releases/latest",
    // Who may turn league members off on /admin/members. Use ADMIN_ACCOUNT_IDS: sign in, open /account, read the
    // "account number" at the bottom of the page and put it here ("1" or "1,7"). A number belongs to one account for
    // good, so this can never point at somebody else. ADMIN_USERNAMES (comma-separated usernames) still works for
    // accounts that already exist, but leave it empty if you can: a name listed here can never be registered by
    // anyone (nor can look-alikes of it), so create the account BEFORE you list its name, never after.
    "ADMIN_ACCOUNT_IDS": "1",
    "ADMIN_USERNAMES": "",
    // Sign-ups per day. Past SIGNUP_DAILY_CAP the site counts as busy and gets careful instead of closing: with
    // Turnstile on, that check does the work; with it off, each network (an IPv4 address, an IPv6 /48) may create
    // 1 account a day instead of 3. Only at SIGNUP_HARD_CAP does sign-up pause for everyone until the next day.
    "SIGNUP_DAILY_CAP": "200",
    "SIGNUP_HARD_CAP": "2000",
    // "" leaves the "are you a person" check off (sign-up and invite links then rely on the limits above).
    "TURNSTILE_SITE_KEY": ""
    // Secrets (never in this file):
    //   BRIDGE_TOKEN          wrangler secret put BRIDGE_TOKEN          the whole bridge API (imports, invites, member list ...)
    //   REGISTRY_TOKEN        wrangler secret put REGISTRY_TOKEN        optional; ONLY reads GET /api/bridge/league-registry (the
    //                         member list). Give this one, not BRIDGE_TOKEN, to the public league server; it sends it the same
    //                         way, "Authorization: Bearer <token>". Until it is set, the league server keeps using BRIDGE_TOKEN.
    //   TURNSTILE_SECRET_KEY  wrangler secret put TURNSTILE_SECRET_KEY  only together with TURNSTILE_SITE_KEY
  },
  "observability": { "enabled": true }
}
