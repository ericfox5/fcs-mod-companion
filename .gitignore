node_modules/
dist/
coverage/
.wrangler/
.env
.env.*
!.env.example
# Wayback mirror is reference material only (EA copyright); never commit or deploy it
archive/wayback/
# real save files and anything derived from the game binary stay local
fixtures/real/
spike/blaze/private/
*.elf
*.pfx
*.pem
*.key

# third-party reference clones (GPL/MIT, not ours)
spike/blaze/third_party/
archive/ref/
worker/.dev.vars
.wrangler/
# third-party team/conference logos (ESPN CDN, Wikimedia); fetched by hand, uploaded to R2 by `ncaa-bridge logos upload`
archive/logos/
# forged redirector certificate chain for the local emulator (regenerate with spike/blaze/server/gen-cert.mjs)
spike/blaze/server/certs/
# the NCAA Division I FCS mark in the header is a fair-use file from Wikipedia; add your own copy locally
worker/public/img/fcs-logo.svg
worker/public/img/fcs-header.png
worker/public/img/fcs-header-mark.png
# stray local images at the repo root
/*.jpg
/*.jpeg
/*.png
# source handoff package for Supersim (integrated into worker/src/supersim and worker/public/js/supersim)
FCS-Supersim-Claude-Handoff-v2/
# playbooks extracted from the game's own .ast archives (EA data): regenerate with `npx tsx tools/playbooks-extract.mts`
worker/public/data/playbooks/
# local dev test account (wrangler dev only)
worker/.dev-account.json
# python bytecode caches
__pycache__/

# installer: generated payload (patch words from the game binary) and the built exe
installer/generated/
installer/dist/
# Quickplay rosters generated from the roster save: regenerate with `npx tsx tools/quickplay-data.mts`
worker/public/data/quickplay/
# the 3D player model on the odds board: a third-party Sketchfab model (see tools/hero-model.md); add your own copy locally
worker/public/data/models/
