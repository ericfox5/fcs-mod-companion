# Off-site backup settings. OPTIONAL and OFF by default.
# Installed as /etc/fcs-league/offsite.env, owned by root, mode 600 (only root can read it):
#
#   sudo install -m 600 -o root -g root /opt/fcs-league/app/deploy/league-server/offsite.env.example /etc/fcs-league/offsite.env
#   sudo nano /etc/fcs-league/offsite.env
#
# This file holds two secrets: the storage key and the backup passphrase.
# NEVER commit the real file, paste it in chat, or copy it into league.env.
#
# Format: NAME=value, one per line, no spaces around "=". Lines starting with # are notes.

# on = after each daily backup, encrypt the archive and upload it. off = backups stay on this server only.
FCS_OFFSITE=off

# The storage. For Cloudflare R2: the "S3 API" address shown on the bucket's settings page, without the bucket name.
# It looks like https://<your account id>.r2.cloudflarestorage.com
FCS_OFFSITE_ENDPOINT=https://paste-your-account-id.r2.cloudflarestorage.com

# The bucket. Use a bucket made only for these backups, not the website's bucket.
FCS_OFFSITE_BUCKET=fcs-league-backups

# Folder inside the bucket.
FCS_OFFSITE_PREFIX=league-server

# An API token for that bucket only ("Object Read & Write", limited to this bucket). R2 shows these two values once.
FCS_OFFSITE_ACCESS_KEY_ID=paste-the-access-key-id-here
FCS_OFFSITE_SECRET_ACCESS_KEY=paste-the-secret-access-key-here

# The passphrase the archive is encrypted with before it leaves the server. At least 20 characters.
# Make one with:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE THAT IS NOT THIS SERVER (a password manager). If the server is lost and you do not have the
# passphrase, the off-site backups cannot be opened by anyone.
FCS_OFFSITE_PASSPHRASE=paste-a-long-passphrase-here

# Uploaded copies older than this many days are deleted after each good upload. 0 = never delete from here
# (then set a lifecycle rule on the bucket instead, or it grows forever).
FCS_OFFSITE_KEEP_DAYS=30

# Only for storage that is not Cloudflare R2 (any S3-compatible service): its rclone provider name and region.
#FCS_OFFSITE_PROVIDER=Cloudflare
#FCS_OFFSITE_REGION=auto
