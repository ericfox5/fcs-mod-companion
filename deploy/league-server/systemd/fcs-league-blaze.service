[Unit]
Description=FCS league server: Blaze (logins, dynasties, Locker files, registry sync)
Documentation=file:///opt/fcs-league/app/deploy/league-server/README.md
After=network-online.target
Wants=network-online.target
PartOf=fcs-league.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own user: no other league service can read this one's environment or memory. The group is the one the data
# folder is shared with (the site sync reads it).
User=fcs-blaze
Group=fcsleague
WorkingDirectory=/opt/fcs-league/app/spike/blaze/server
EnvironmentFile=/etc/fcs-league/league.env
# root-only file with NCAA_REGISTRY_TOKEN, the secret that can only READ the member list. systemd reads it before
# dropping to the service user. The full bridge token (bridge.env) is NOT given to this service: it faces the
# internet, and that token can also write to the site.
EnvironmentFile=/etc/fcs-league/registry.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/fcs-league
ExecStart=/usr/bin/node blaze.mjs
# Always comes back by itself. Whatever stops it (a crash, the memory limit below, a settings mistake) it is started
# again: after 5 seconds, then with longer pauses up to one minute if it keeps stopping. There is no "too many
# restarts" lockout (StartLimitIntervalSec=0 above), so a bad hour never leaves the league down until somebody logs
# in to the server. "systemctl stop" still stops it. A settings mistake shows as one "cannot start" line a minute.
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=15
LimitNOFILE=65536
# Slowed down above MemoryHigh, stopped (and started again, see Restart) at MemoryMax.
MemoryHigh=768M
MemoryMax=1G
TasksMax=256

# ---- sandbox: the service can write its data folder and nothing else ----
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fcs-league/private
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=fcs-league.target
